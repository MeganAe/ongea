rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function onlyOwnMapEntryChanged(fieldName) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([fieldName])
        || request.resource.data[fieldName].diff(resource.data[fieldName])
            .affectedKeys().hasOnly([request.auth.uid]);
    }

    function usersAllowDirectChat(firstUid, secondUid) {
      return !get(/databases/$(database)/documents/users/$(firstUid)).data.get('blockedUsers', []).hasAny([secondUid])
        && !get(/databases/$(database)/documents/users/$(secondUid)).data.get('blockedUsers', []).hasAny([firstUid]);
    }

    function senderIsBlockedInDirectChat(chatId) {
      let members = get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      let peerUid = members[0] == request.auth.uid ? members[1] : members[0];
      return members.size() == 2
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blockedUsers', []).hasAny([peerUid])
          || get(/databases/$(database)/documents/users/$(peerUid)).data.get('blockedUsers', []).hasAny([request.auth.uid])
        );
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'photoUrl', 'photoPublicId', 'lastSeen', 'fcmToken', 'blockedUsers', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.email is string;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'photoUrl', 'photoPublicId', 'lastSeen', 'fcmToken', 'blockedUsers', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Profil public minimal pour la découverte des contacts ; e-mail et jeton FCM restent privés.
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'photoUrl', 'lastSeen', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photoUrl', 'lastSeen', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participants', 'lastMessage', 'lastMessageAt', 'unreadCount', 'pinned',
          'muted', 'archived', 'favorite', 'locked', 'createdAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.lastMessage is string
        && request.resource.data.unreadCount is map
        && request.resource.data.pinned is map
        && request.resource.data.muted is map
        && request.resource.data.archived is map
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[0]))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.participants[1]))
        && usersAllowDirectChat(request.resource.data.participants[0], request.resource.data.participants[1]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'unreadCount', 'pinned', 'muted', 'archived', 'favorite', 'locked'
        ])
        && onlyOwnMapEntryChanged('unreadCount')
        && onlyOwnMapEntryChanged('pinned')
        && onlyOwnMapEntryChanged('muted')
        && onlyOwnMapEntryChanged('archived')
        && onlyOwnMapEntryChanged('favorite')
        && onlyOwnMapEntryChanged('locked');
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && !senderIsBlockedInDirectChat(chatId)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'imageUrl', 'createdAt', 'status'])
          && request.resource.data.keys().hasAll(['senderId', 'text', 'imageUrl', 'createdAt', 'status'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && (request.resource.data.imageUrl == null || request.resource.data.imageUrl is string)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.status == 'sent';
        allow update: if isChatParticipant(chatId)
          && request.auth.uid != resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (
            (resource.data.status == 'sent' && request.resource.data.status in ['delivered', 'read'])
            || (resource.data.status == 'delivered' && request.resource.data.status == 'read')
          );
        allow delete: if false;
      }
    }

    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'text', 'imageUrl', 'imagePublicId', 'createdAt', 'expiresAt', 'viewedBy'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && (request.resource.data.text is string || request.resource.data.imageUrl is string)
        && request.resource.data.expiresAt is timestamp
        && (request.resource.data.get('imagePublicId', null) == null
          || request.resource.data.imagePublicId is string)
        && request.resource.data.viewedBy is list;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy'])
        && request.auth.uid in request.resource.data.viewedBy;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'reportedId', 'reason', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId is string;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
